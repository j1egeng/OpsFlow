# Copy to .env.docker and fill secrets, or run deploy/Initialize-Docker.ps1.
# These credentials belong to the NEW container database, not local PostgreSQL.
OPSFLOW_HTTP_PORT=8088
OPSFLOW_DB_PASSWORD=
JWT_SECRET_BASE64=
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=dockeradmin
BOOTSTRAP_ADMIN_EMAIL=dockeradmin@example.test
BOOTSTRAP_ADMIN_PASSWORD=
